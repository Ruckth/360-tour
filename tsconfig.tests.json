{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "tests/**/*.ts",
    "convex/**/*.test.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "opensrc", "archive"]
}
