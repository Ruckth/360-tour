{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "next-env.d.ts",
    "types/**/*.d.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "playwright.booking.config.ts",
    "convex/**/*.test.ts",
    "scripts/**/*.ts",
    "playwright.config.ts",
    "playwright.bench.config.ts",
    "vitest.config.ts",
    "vitest.bench.config.ts",
    "scripts/local-integration-config.mjs"
  ],
  "exclude": [
    "node_modules",
    "opensrc",
    "archive"
  ]
}
