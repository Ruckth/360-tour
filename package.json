{
  "name": "360-tour",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npx convex dev --once && next dev",
    "dev:next": "next dev",
    "dev:demo": "NEXT_PUBLIC_CONVEX_URL=placeholder NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=placeholder next dev",
    "dev:convex": "npx convex dev",
    "dev:full": "npx convex dev & next dev",
    "build": "next build",
    "preview": "next start",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:tests && pnpm typecheck:convex",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "typecheck:convex": "tsc --noEmit -p convex/tsconfig.json",
    "check": "pnpm typecheck",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:booking-ui": "playwright test -c playwright.booking.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "e2e:server": "node scripts/e2e-server.mjs",
    "bench:routes": "node scripts/bench/route-js-size.mjs",
    "bench:browser": "playwright test -c playwright.bench.config.ts",
    "bench:messaging": "vitest run -c vitest.bench.config.ts",
    "verify": "pnpm check && pnpm lint && pnpm test:unit && pnpm build",
    "vercel-build": "npx convex deploy --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL --cmd 'pnpm build'",
    "seed": "npx convex run seed:seedAll",
    "eval:ai-booking": "node scripts/ai-booking-eval.ts",
    "ui-loop:capture": "node scripts/ui-loop/capture.ts",
    "ui-loop:audit": "node scripts/ui-loop/audit.ts",
    "ui-loop:report": "node scripts/ui-loop/report.ts",
    "ui-loop:anchors": "node scripts/ui-loop/anchors.ts",
    "ui-loop:annotate": "node scripts/ui-loop/annotate.ts",
    "arch:score": "node scripts/arch-scorecard.mjs",
    "knip": "knip --include files,dependencies,unlisted,unresolved --treat-config-hints-as-errors"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.2.54",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.176.0",
    "convex-test": "^0.0.53",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.45.1",
    "typescript": "^5.9.3",
    "vite": "8.0.13",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.3.7",
    "@date-fns/tz": "^1.5.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@sentry/nextjs": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.34.1",
    "convex-helpers": "^0.1.135",
    "date-fns": "^4.1.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.552.0",
    "next": "^16.0.0",
    "next-intl": "^4.12.0",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.434.12",
    "qr-scanner": "^1.4.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-phone-number-input": "^3.4.18",
    "react-qr-code": "^2.2.0",
    "react-textarea-autosize": "^8.5.9",
    "resend": "^6.10.0",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.175.0"
  }
}
