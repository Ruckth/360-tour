{
  "name": "360-tour",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/local-dev.mjs",
    "dev:next": "next dev",
    "dev:convex": "npx convex dev",
    "dev:full": "pnpm dev",
    "build": "node scripts/heavy.mjs next build",
    "preview": "next start",
    "typecheck": "node scripts/run-checks.mjs --parallel typecheck:app typecheck:tests typecheck:convex",
    "typecheck:app": "node node_modules/@typescript/native/bin/tsc --checkers 1 --noEmit -p tsconfig.json",
    "typecheck:tests": "node node_modules/@typescript/native/bin/tsc --checkers 1 --noEmit -p tsconfig.tests.json",
    "typecheck:convex": "node node_modules/@typescript/native/bin/tsc --checkers 1 --noEmit -p convex/tsconfig.json",
    "check": "pnpm typecheck",
    "lint": "eslint . --max-warnings 0 && pnpm lint:types",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "node scripts/heavy.mjs vitest run",
    "test:pure": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:convex": "vitest run --project convex",
    "test:dev": "node scripts/local-dev-check.mjs",
    "test:booking-ui": "node scripts/heavy.mjs playwright test -c playwright.booking.config.ts",
    "test:e2e": "node scripts/heavy.mjs node scripts/local-integration.mjs",
    "test:e2e:smoke": "node scripts/heavy.mjs node scripts/local-integration.mjs -- pnpm exec playwright test --grep @smoke",
    "bench:routes": "node scripts/bench/route-js-size.mjs",
    "bench:browser": "playwright test -c playwright.bench.config.ts",
    "bench:messaging": "vitest run -c vitest.bench.config.ts",
    "verify": "node scripts/heavy.mjs node scripts/run-checks.mjs check lint test:unit build",
    "vercel-build": "pnpm typecheck && node scripts/vercel-build.mjs",
    "preview:retention": "node scripts/preview-retention.mjs",
    "seed": "npx convex run maintenance/seed:seedAll",
    "eval:ai-booking": "node scripts/ai-booking-eval.ts",
    "ui-loop:capture": "node scripts/ui-loop/capture.ts",
    "ui-loop:audit": "node scripts/ui-loop/audit.ts",
    "ui-loop:report": "node scripts/ui-loop/report.ts",
    "ui-loop:anchors": "node scripts/ui-loop/anchors.ts",
    "ui-loop:annotate": "node scripts/ui-loop/annotate.ts",
    "arch:score": "node scripts/arch-scorecard.mjs",
    "knip": "knip --include files,dependencies,unlisted,unresolved --treat-config-hints-as-errors",
    "verify:integration": "node scripts/heavy.mjs node scripts/local-integration.mjs --verify",
    "lint:types": "oxlint --type-aware -A all -D typescript/no-floating-promises",
    "lint:fast": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location node_modules/.cache/eslint",
    "check:fast": "pnpm typecheck && pnpm lint:types && pnpm lint:fast",
    "test:guards": "vitest run --project guards"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.2.54",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.176.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "convex-test": "^0.0.53",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.0",
    "happy-dom": "^20.14.5",
    "knip": "^6.45.1",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^5.9.3",
    "vite": "8.0.13",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.3.7",
    "@convex-dev/rate-limiter": "0.3.2",
    "@date-fns/tz": "^1.5.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@sentry/nextjs": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.50.0",
    "convex-helpers": "0.1.120",
    "date-fns": "^4.1.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.552.0",
    "next": "^16.0.0",
    "next-intl": "^4.12.0",
    "pdf-lib": "^1.17.1",
    "posthog-js": "^1.434.12",
    "qr-scanner": "^1.4.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-phone-number-input": "^3.4.18",
    "react-qr-code": "^2.2.0",
    "react-textarea-autosize": "^8.5.9",
    "resend": "^6.10.0",
    "sharp": "0.34.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.175.0"
  }
}
