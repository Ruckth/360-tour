# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-project.convex.site
# Required in Vercel Production/Preview for `pnpm vercel-build`.
# Generate this in the Convex dashboard and add it as a Vercel environment variable.
CONVEX_DEPLOY_KEY=

# Clerk (optional for demo launch; keep placeholder to disable auth UI)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=placeholder

# Admin chat dashboard (Convex env; comma-separated Clerk account emails)
ADMIN_EMAILS=owner@example.com,manager@example.com

# Stripe (set in Convex; webhook URL is https://YOUR-CONVEX-DEPLOYMENT.convex.site/stripe/webhook)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (for transactional emails)
RESEND_API_KEY=re_...
EMAIL_FROM=Auralis Cove <bookings@your-verified-domain.com>

# Optional monitoring (Vercel)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# AI Chat (xAI Grok via OpenAI-compatible API)
AI_API_KEY=<xAI key>
AI_API_BASE_URL=https://api.x.ai/v1
AI_SIMPLE_MODEL=grok-4.3
AI_COMPLEX_MODEL=grok-4.3

# LINE Messaging API webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SITE_URL=http://localhost:3000

# Facebook Messenger Platform webhook
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v25.0

# WhatsApp Business Platform webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v25.0

# Instagram Messaging API webhook
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Alternatively, one shared Meta app secret for all three channels:
META_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v25.0

# Owner notification
OWNER_NOTIFICATION_EMAIL=owner@example.com
