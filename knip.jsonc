{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Next's plugin discovers app routes, layouts, instrumentation, middleware and config.
  "next": true,
  // Heavy wrappers hide CLI flags from script discovery; keep every Playwright config explicit.
  "playwright": { "config": ["playwright*.config.ts"] },
  // Convex exports functions by file path; maintenance and test module discovery are dynamic.
  "entry": [
    "convex/*.ts!",
    "convex/maintenance/*.ts!",
    "tests/**/*.test.ts",
    "tests/**/*.spec.ts",
    "tests/e2e/auth.setup.ts",
    "tests/browser/*fixture*.tsx",
    "tests/browser/*-mock.{ts,tsx}",
    "tests/browser/vite.config.ts",
    "scripts/**/*.{ts,mjs}",
    "*.config.{ts,mjs}"
  ],
  "project": ["src/**/*.{ts,tsx,css}", "convex/**/*.ts", "tests/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"],
  // Install-layout pin, never imported: it keeps @clerk/nextjs and @clerk/react on one shared copy
  // (tests/unit/clerk-shared-dedupe.test.ts explains and enforces it).
  // The Floating UI pin shares the runtime already used by both installed Radix Popper versions.
  "ignoreDependencies": ["@clerk/shared", "@floating-ui/react-dom"]
}
